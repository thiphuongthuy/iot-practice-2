# Sao chép thành config/.env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.
# --- MQTT: Wokwi không truy cập được localhost, nên dùng broker công cộng hoặc HiveMQ Cloud ---
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=false            # HiveMQ Cloud: MQTT_PORT=8883, MQTT_TLS=true, và điền MQTT_USER/MQTT_PASS
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC=iot/b23dccn847/+/telemetry     # phải khớp SITE trong wokwi/sketch.ino

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change_me_token              # phải trùng DOCKER_INFLUXDB_INIT_ADMIN_TOKEN trong docker-compose.yml
INFLUX_ORG=iot-lab
RAW_BUCKET=iot_raw
PROC_BUCKET=iot_processed

DEVICE_ID=esp32-01
SITE=b23dccn847
